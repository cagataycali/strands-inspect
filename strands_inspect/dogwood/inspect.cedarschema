// The Inspect action schema of strands-inspect (generated from inspect_schema.py; do not edit).
namespace Inspect {
  entity Function = { module: String, name: String };
  entity Process = { pid: Long, cwd: String };
  type Output = { allowed: Bool };
  type SystemContext = { now: datetime, session: String };
  type FileReadInput = { detail: String, op: String, path: String, mode: String, sensitive: Bool };
  type FileWriteInput = { detail: String, op: String, path: String, mode: String, sensitive: Bool };
  type FileDeleteInput = { detail: String, op: String, path: String };
  type FileMoveInput = { detail: String, op: String, src: String, dst: String };
  type FileChmodInput = { detail: String, op: String, path: String, mode: String };
  type FileLinkInput = { detail: String, op: String, src: String, dst: String };
  type FileMkdirInput = { detail: String, op: String, path: String };
  type FileFdIoInput = { detail: String, op: String, fd: Long, size: Long };
  type FileSpecialInput = { detail: String, op: String, path: String };
  type NetworkInput = { detail: String, op: String, host: String, port: Long, url: String, scheme: String, method: String };
  type NetSocketInput = { detail: String, op: String, host: String, port: Long, size: Long };
  type SubprocessInput = { detail: String, op: String, command: String, program: String, argv: Set<String>, shell: Bool };
  type OsSystemInput = { detail: String, op: String, command: String, program: String, argv: Set<String>, shell: Bool };
  type OsExecInput = { detail: String, op: String, command: String, program: String, argv: Set<String>, shell: Bool };
  type ProcessForkInput = { detail: String, op: String };
  type ProcessKillInput = { detail: String, op: String, pid: Long, signal: Long };
  type ProcessMpInput = { detail: String, op: String, name: String, target: String };
  type ImportInput = { detail: String, op: String, module: String, package: String };
  type MetaCtypesInput = { detail: String, op: String, library: String };
  type MetaCodeInput = { detail: String, op: String, source: String };
  action "file";
  action "net";
  action "os";
  action "process";
  action "meta";
  action "file.read" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileReadInput, output?: Output, system: SystemContext } };
  action "file.write" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileWriteInput, output?: Output, system: SystemContext } };
  action "file.delete" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileDeleteInput, output?: Output, system: SystemContext } };
  action "file.move" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileMoveInput, output?: Output, system: SystemContext } };
  action "file.chmod" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileChmodInput, output?: Output, system: SystemContext } };
  action "file.link" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileLinkInput, output?: Output, system: SystemContext } };
  action "file.mkdir" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileMkdirInput, output?: Output, system: SystemContext } };
  action "file.fd_io" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileFdIoInput, output?: Output, system: SystemContext } };
  action "file.special" in [Action::"file"] appliesTo { principal: [Function], resource: [Process], context: { input: FileSpecialInput, output?: Output, system: SystemContext } };
  action "network" in [Action::"net"] appliesTo { principal: [Function], resource: [Process], context: { input: NetworkInput, output?: Output, system: SystemContext } };
  action "net.socket" in [Action::"net"] appliesTo { principal: [Function], resource: [Process], context: { input: NetSocketInput, output?: Output, system: SystemContext } };
